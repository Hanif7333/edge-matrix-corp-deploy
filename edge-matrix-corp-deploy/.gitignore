# ============================================================================
# Edge Matrix Corporation — Production .gitignore
# Next.js / TypeScript / Tailwind CSS
# ============================================================================

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Build Outputs ───────────────────────────────────────────────────────────
/.next/
/out/
/build/
/dist/
*.tsbuildinfo
next-env.d.ts

# ─── Testing ─────────────────────────────────────────────────────────────────
/coverage/
/test-results/
/playwright-report/
/blob-report/

# ─── Environment Variables ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Hosting / Deployment ───────────────────────────────────────────────────
.vercel
.netlify
.railway

# ─── Debug Logs ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Caching ─────────────────────────────────────────────────────────────────
.turbo
.cache
.eslintcache

# ─── OS / IDE ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Security ────────────────────────────────────────────────────────────────
*.pem
*.key
*.cert

# ─── AI Agent Config (not needed in deployment) ─────────────────────────────
AGENTS.md
CLAUDE.md
