# ============================================================================
# Edge Matrix Corporation — Environment Variables Template
# Copy this file to .env.local and fill in the values.
# ============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://www.edgematrixcorp.com

# ─── Analytics (Vercel) ──────────────────────────────────────────────────────
# Vercel Analytics and Speed Insights are auto-configured when deployed
# to Vercel. No environment variables are needed for them.

# ─── Database (if applicable in the future) ──────────────────────────────────
# DATABASE_URL=

# ─── Email / SMTP (if contact form backend is added) ─────────────────────────
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# CONTACT_EMAIL=writeus@edgematrixcorp.com

# ─── Authentication (if applicable in the future) ────────────────────────────
# NEXTAUTH_URL=
# NEXTAUTH_SECRET=
